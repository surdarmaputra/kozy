# ID of the Google Sheet, taken from its URL:
# docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The sheet must be shared as "Anyone with the link -> Viewer".
# Leave empty to render the committed src/data/snapshot.json instead.
SHEET_ID=

# Any long random string. It guards /purge?secret=...
# Generate one with: openssl rand -hex 24
PURGE_SECRET=
