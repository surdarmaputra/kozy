# Both variables are server-side only and never reach the browser.
# See the README for how to obtain each value.
# Loaded automatically by `npm run dev` and `npm run snapshot`.

# The id from your spreadsheet's /edit URL, between /d/ and the next slash:
#   docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The Sheet must be shared as "Anyone with the link -> Viewer".
# Leave empty to render the committed dev seed src/data/snapshot.json instead.
SHEET_ID=

# Guards /purge?secret=... Generate one, do not invent it:
#   openssl rand -hex 24
# Optional. Leave empty to skip purging entirely: Sheet edits then just catch up
# on their own in about 1-2 minutes (CDN s-maxage=60 + stale-while-revalidate).
# Set it only if you want the /purge bookmark to force an immediate refresh.
PURGE_SECRET=

# Where the last successful fetch is cached so a Sheet outage serves that copy
# instead of an unavailable page. Defaults to .cache/ (gitignored). On Netlify
# this is ignored: Netlify Blobs is used instead (see NETLIFY_DEPLOYMENT).
CACHE_DIR=.cache

# Set to true to run Netlify's local edge-functions emulator during `npm run dev`
# (production parity: redirects, headers, edge context). Off by default so local
# dev is pure Vite + TanStack Start SSR. `vite build` always targets Netlify
# regardless of this value.
NETLIFY_DEPLOYMENT=false
